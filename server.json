{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.trycourier/courier",
  "title": "Courier",
  "description": "Courier's official MCP server for sending notifications, managing templates, and configuring integrations.",
  "repository": {
    "url": "https://github.com/trycourier/courier-mcp",
    "source": "github"
  },
  "version": "1.3.1",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.courier.com",
      "headers": [
        {
          "name": "api_key",
          "description": "Your Courier API key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
